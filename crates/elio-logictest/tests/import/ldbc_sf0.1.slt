# Relationships
query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/forum_containerOf_post_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (f:Forum {id: toInteger(row.`Forum.id`)}), (p:Post {id: toInteger(row.`Post.id`)})
CREATE (f)-[:CONTAINER_OF]->(p);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/comment_hasCreator_person_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (c:Comment {id: toInteger(row.`Comment.id`)}), (p:Person {id: toInteger(row.`Person.id`)})
CREATE (c)-[:COMMENT_HAS_CREATOR]->(p);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/post_hasCreator_person_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Post {id: toInteger(row.`Post.id`)}), (a:Person {id: toInteger(row.`Person.id`)})
CREATE (p)-[:POST_HAS_CREATOR]->(a);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/person_hasInterest_tag_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Person {id: toInteger(row.`Person.id`)}), (t:Tag {id: toInteger(row.`Tag.id`)})
CREATE (p)-[:HAS_INTEREST]->(t);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/forum_hasMember_person_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (f:Forum {id: toInteger(row.`Forum.id`)}), (p:Person {id: toInteger(row.`Person.id`)})
CREATE (f)-[:HAS_MEMBER {joinDate: datetime(row.joinDate)}]->(p);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/forum_hasModerator_person_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (f:Forum {id: toInteger(row.`Forum.id`)}), (p:Person {id: toInteger(row.`Person.id`)})
CREATE (f)-[:HAS_MODERATOR]->(p);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/comment_hasTag_tag_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (c:Comment {id: toInteger(row.`Comment.id`)}), (t:Tag {id: toInteger(row.`Tag.id`)})
CREATE (c)-[:COMMENT_HAS_TAG]->(t);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/forum_hasTag_tag_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (f:Forum {id: toInteger(row.`Forum.id`)}), (t:Tag {id: toInteger(row.`Tag.id`)})
CREATE (f)-[:FORUM_HAS_TAG]->(t);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/post_hasTag_tag_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Post {id: toInteger(row.`Post.id`)}), (t:Tag {id: toInteger(row.`Tag.id`)})
CREATE (p)-[:POST_HAS_TAG]->(t);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/tag_hasType_tagclass_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (t:Tag {id: toInteger(row.`Tag.id`)}), (tc:TagClass {id: toInteger(row.`TagClass.id`)})
CREATE (t)-[:HAS_TYPE]->(tc);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/comment_isLocatedIn_place_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (c:Comment {id: toInteger(row.`Comment.id`)}), (p:Place {id: toInteger(row.`Place.id`)})
CREATE (c)-[:COMMENT_IS_LOCATED_IN]->(p);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/organisation_isLocatedIn_place_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (o:Organisation {id: toInteger(row.`Organisation.id`)}), (p:Place {id: toInteger(row.`Place.id`)})
CREATE (o)-[:ORGANISATION_IS_LOCATED_IN]->(p);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/person_isLocatedIn_place_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Person {id: toInteger(row.`Person.id`)}), (l:Place {id: toInteger(row.`Place.id`)})
CREATE (p)-[:PERSON_IS_LOCATED_IN]->(l);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/post_isLocatedIn_place_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Post {id: toInteger(row.`Post.id`)}), (l:Place {id: toInteger(row.`Place.id`)})
CREATE (p)-[:POST_IS_LOCATED_IN]->(l);
----

query AAAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/place_isPartOf_place_0_0.csv' OPTIONS {header: false, delimiter: '|'} AS row
WITH toInteger(row[0]) AS childPlaceId, toInteger(row[1]) AS parentPlaceId
MATCH (child:Place {id: childPlaceId}), (parent:Place {id: parentPlaceId})
CREATE (child)-[:IS_PART_OF]->(parent);
----

query AAAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/tagclass_isSubclassOf_tagclass_0_0.csv' OPTIONS {header: false, delimiter: '|'} AS row
WITH toInteger(row[0]) AS childId, toInteger(row[1]) AS parentId
MATCH (child:TagClass {id: childId}), (parent:TagClass {id: parentId})
CREATE (child)-[:IS_SUBCLASS_OF]->(parent);
----

query AAAAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/person_knows_person_0_0.csv' OPTIONS {header: false, delimiter: '|'} AS row
WITH toInteger(row[0]) AS personId, toInteger(row[1]) AS friendId, datetime(row[2]) AS creationDate
MATCH (p1:Person {id: personId}), (p2:Person {id: friendId})
CREATE (p1)-[:KNOWS {creationDate: creationDate}]->(p2);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/person_likes_comment_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Person {id: toInteger(row.`Person.id`)}), (c:Comment {id: toInteger(row.`Comment.id`)})
CREATE (p)-[:LIKES_COMMENT {creationDate: datetime(row.creationDate)}]->(c);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/person_likes_post_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Person {id: toInteger(row.`Person.id`)}), (post:Post {id: toInteger(row.`Post.id`)})
CREATE (p)-[:LIKES_POST {creationDate: datetime(row.creationDate)}]->(post);
----

query AAAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/comment_replyOf_comment_0_0.csv' OPTIONS {header: false, delimiter: '|'} AS row
WITH toInteger(row[0]) AS childId, toInteger(row[1]) AS parentId
MATCH (child:Comment {id: childId}), (parent:Comment {id: parentId})
CREATE (child)-[:REPLY_OF_COMMENT]->(parent);
----

query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/comment_replyOf_post_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (c:Comment {id: toInteger(row.`Comment.id`)}), (p:Post {id: toInteger(row.`Post.id`)})
CREATE (c)-[:REPLY_OF_POST]->(p);
