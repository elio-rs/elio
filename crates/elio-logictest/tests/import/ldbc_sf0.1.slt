query AAA
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/person_studyAt_organisation_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
MATCH (p:Person {id: toInteger(row.`Person.id`)}), (o:Organisation {id: toInteger(row.`Organisation.id`)})
