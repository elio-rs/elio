# import ldbc snb sf 0.1

# Node

query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/person_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:Person {id: toInteger(row.id), firstName: row.firstName, lastName: row.lastName, gender: row.gender, birthday: date(row.birthday), creationDate: datetime(row.creationDate), locationIP: row.locationIP, browserUsed: row.browserUsed});
----

query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/forum_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:Forum {id: toInteger(row.id), title: row.title, creationDate: datetime(row.creationDate)});
----

query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/post_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:Post {id: toInteger(row.id), imageFile: row.imageFile, creationDate: datetime(row.creationDate), locationIP: row.locationIP, browserUsed: row.browserUsed, language: row.language, content: row.content, length: toInteger(row.length)});
----

query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/dynamic/comment_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:Comment {id: toInteger(row.id), creationDate: datetime(row.creationDate), locationIP: row.locationIP, browserUsed: row.browserUsed, content: row.content, length: toInteger(row.length)});
----


query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/tag_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:Tag {id: toInteger(row.id), name: row.name, url: row.url});
----


query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/tagclass_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:TagClass {id: toInteger(row.id), name: row.name, url: row.url});
----


query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/place_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:Place {id: toInteger(row.id), name: row.name, url: row.url, type: row.type});
----


query A
LOAD CSV FROM '../../dataset/ldbc_sf0.1/static/organisation_0_0.csv' OPTIONS {header: true, delimiter: '|'} AS row
CREATE (:Organisation {id: toInteger(row.id), type: row.type, name: row.name, url: row.url});
----


# Node key constraints

query A
CREATE CONSTRAINT pk_person FOR (n:Person) REQUIRE n.id IS NODE KEY;
----
'Constraint created/dropped'

query A
CREATE CONSTRAINT pk_forum FOR (n:Forum) REQUIRE n.id IS NODE KEY;
